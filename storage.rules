rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Deny access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Strict User-Isolated Attachments:
    // Only the authenticated user can access and upload files into their own folder.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId
                          && request.resource.size < 15 * 1024 * 1024; // 15MB max file size
    }
  }
}
