rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Row Level Security (RLS)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // 1. User Profiles & User Subcollections (tasks, notes, exams, timetable, sessions, etc.)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Academic Tasks: Strict Row Level Security by userId
    match /tasks/{taskId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // 3. Study Notes: Strict Row Level Security by userId
    match /notes/{noteId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // 4. Exams & Deadlines: Strict Row Level Security by userId
    match /exams/{examId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // 5. Flashcards Decks: Strict Row Level Security by userId
    match /flashcards/{deckId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // 6. Timetable Classes: Strict Row Level Security by userId
    match /timetable/{timetableId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // 7. Habits & Streaks: Strict Row Level Security by userId
    match /habits/{habitId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // 8. Focus Timer Sessions: Strict Row Level Security by userId
    match /timerSessions/{sessionId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // 9. Study Groups: Authenticated users can read; only admin can modify
    match /studyGroups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.adminId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    // Deny all other collections by default (Zero-Trust Security)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
